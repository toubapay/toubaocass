APP_NAME=Intercity
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=toubaocass
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Local dev: "public" (symlinked to public/storage, world-readable).
# Production (e.g. Railway): "s3" — see AWS_* vars below.
FILESYSTEM_DISK=public
# Driver KYC documents always use a separate, private disk. Local dev keeps
# these on "local" (private, no public URL). Production: "kyc" (private
# S3/R2 bucket).
KYC_FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- File storage (production — see backend/DEPLOY.md) ---
# AWS_BUCKET should be a public bucket (car photos); AWS_KYC_BUCKET must be
# private (driver ID/license/selfie uploads). Works with real AWS S3 as-is
# (leave AWS_ENDPOINT blank, region e.g. us-east-1). For an S3-compatible
# provider instead (e.g. Cloudflare R2), set AWS_ENDPOINT to its endpoint
# URL, AWS_DEFAULT_REGION=auto, and AWS_USE_PATH_STYLE_ENDPOINT=true.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_KYC_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=

VITE_APP_NAME="${APP_NAME}"

# --- OTP ---
OTP_TTL_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
# Set to a fixed 6-digit code (e.g. 123456) to bypass real SMS during local
# development/demoing. Leave unset in production.
OTP_BYPASS_CODE=

# --- SMS (driver: log | twilio) ---
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Push notifications (driver: log | fcm) ---
PUSH_DRIVER=log
FCM_PROJECT_ID=
# Paste the whole service-account JSON file's contents as one line (it's
# already valid single-line JSON with \n escapes in "private_key" — no
# reformatting needed). docker/entrypoint.sh writes it to
# storage/app/fcm-credentials.json at container boot; config/services.php
# defaults FCM_CREDENTIALS_PATH to that same path, so you don't need to set
# it separately in production. For local dev, either set FCM_CREDENTIALS_JSON
# too, or skip it and leave PUSH_DRIVER=log.
FCM_CREDENTIALS_JSON=
FCM_CREDENTIALS_PATH=
