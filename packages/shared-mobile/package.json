{
  "name": "shared-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Code shared between the rider and driver Expo apps — API client, domain types, theme, and a handful of screens/components that are identical (or differ only by additive, role-specific fields) between the two. Referenced via a file: dependency from each app's package.json. No single entry point — always imported by subpath, e.g. `shared-mobile/src/theme`.",
  "peerDependencies": {
    "@expo/vector-icons": "*",
    "@react-native-async-storage/async-storage": "*",
    "axios": "*",
    "expo-audio": "*",
    "expo-constants": "*",
    "expo-location": "*",
    "expo-secure-store": "*",
    "react": "*",
    "react-i18next": "*",
    "react-native": "*",
    "react-native-maps": "*",
    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@types/react": "~19.2.2",
    "axios": "^1.18.1",
    "expo-audio": "~57.0.3",
    "expo-constants": "^57.0.3",
    "expo-location": "^57.0.2",
    "expo-secure-store": "^57.0.4",
    "react": "19.2.3",
    "react-i18next": "^17.0.10",
    "react-native": "^0.86.2",
    "react-native-maps": "^1.29.0",
    "react-native-safe-area-context": "^5.8.0",
    "typescript": "~6.0.3"
  }
}
