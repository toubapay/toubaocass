server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Bare "/driver" or "/admin" (no trailing slash) must redirect first —
    # otherwise they'd fall through to the "/" location below and serve the
    # rider web app's index.html instead of the driver/admin app.
    location = /driver {
        return 301 /driver/;
    }
    location = /admin {
        return 301 /admin/;
    }

    # index.html and sw.js must always be revalidated. Every build produces
    # freshly content-hashed asset filenames (e.g. TripsListPage-a1b2c3.js)
    # and the previous dist/ is replaced wholesale — nothing keeps old
    # hashes around. Without an explicit no-cache here, a browser's default
    # heuristic caching can keep serving an index.html from a previous
    # deploy after a new one lands; its <script> tags then point at asset
    # files that no longer exist, the JS 404s, and the app fails to mount
    # at all — a blank white screen with no error UI to explain it, since
    # nothing ever ran to render one. Exact-match locations are checked
    # before the prefix locations below, so these win for these two paths.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /driver/index.html {
        add_header Cache-Control "no-cache";
    }
    location = /driver/sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /admin/index.html {
        add_header Cache-Control "no-cache";
    }

    # apps/driver-web, built with `base: '/driver/'` — its own asset URLs
    # already come out prefixed with /driver/, so `alias` here just strips
    # the location prefix back off to find the files on disk.
    location /driver/ {
        alias /usr/share/nginx/html/driver/;
        try_files $uri $uri/ /driver/index.html;
    }

    # apps/admin, built with `base: '/admin/'` — same reasoning.
    location /admin/ {
        alias /usr/share/nginx/html/admin/;
        try_files $uri $uri/ /admin/index.html;
    }

    # apps/web (rider web app) owns the domain root. React Router
    # client-side routing: any path that isn't a real static file falls
    # back to index.html so deep links (e.g. /trips/5) work on direct
    # load/refresh, not just client-side navigation.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
