# Points the app at your Laravel backend. Use your machine's LAN IP instead
# of localhost when testing on a physical device.
API_BASE_URL=http://localhost:8000/api

# Required to render the interactive departure-pin map (react-native-maps)
# on iOS/Android. Get one at
# https://console.cloud.google.com/google/maps-apis with the "Maps SDK for
# Android" and "Maps SDK for iOS" APIs enabled. Not needed for
# `expo start --web` — the web build falls back to a "use current location"
# button without the map preview.
GOOGLE_MAPS_API_KEY=
