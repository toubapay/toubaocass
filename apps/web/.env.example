# Points the web app at your Laravel backend.
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase (Cloud Messaging web push) — use the SAME Firebase project as the
# backend's FCM_PROJECT_ID and the mobile apps' google-services.json /
# GoogleService-Info.plist, so all three clients receive push notifications
# through one account. Get these from Firebase Console > Project settings >
# General > Your apps > Web app (</> icon). These are public client
# identifiers, not secrets — safe to expose in the built JS bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console > Project settings > Cloud Messaging > Web Push
# certificates > generate a key pair.
VITE_FIREBASE_VAPID_KEY=

# The same values above (minus the VAPID key) also need to be pasted into
# public/sw.js — see the comment there for why (it's a static file, can't
# read these env vars at runtime).

# Google Maps JavaScript API key (with the "Places API" also enabled on the
# same project/key) — powers the map + autocomplete address picker in
# Settings. Create a browser key restricted by HTTP referrer in Google Cloud
# Console. Without this set, the address picker falls back to a plain text
# field + "use my current location" button (no map, no suggestions).
VITE_GOOGLE_MAPS_API_KEY=
