server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # React Router client-side routing: any path that isn't a real static
    # file falls back to index.html so deep links (e.g. /users/5) work on
    # direct load/refresh, not just client-side navigation.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
