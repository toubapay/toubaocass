# Points the admin app at your Laravel backend's /api/admin routes.
VITE_ADMIN_API_BASE_URL=http://localhost:8000/api/admin

# Client-side Maps JavaScript API key for the live trips map — same key
# used by apps/web/apps/driver-web (see their own .env.example). Leave
# unset in development and the live trips page falls back to a plain
# coordinates list instead of a broken map.
VITE_GOOGLE_MAPS_API_KEY=
